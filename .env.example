# Required: WebSocket auth token
WS_TOKEN=your-secret-token-here

# Optional: restrict WebSocket origins
ALLOWED_ORIGIN=https://lab.yourdomain.com

# Optional: published docs/public base URL used by /share
PUBLIC_BASE_URL=https://docs.yourdomain.com

# LLM API keys (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: GitHub CLI — prefer `gh auth login` as www-data over setting GH_TOKEN
# (GH_TOKEN overrides gh's config and won't pick up scope changes from `gh auth refresh`)
GH_TOKEN=
